# Secret token that your bot will include in x-bot-token header
BOT_TO_UI_TOKEN=replace_with_a_long_random_token

# Origin allowed to fetch (restrict to your UI domain in production)
UI_ORIGIN=https://dashboard.example.com

# Server port
PORT=3001

# Taille maximale du JSON brut envoyé par le bot (instantanés météo inclus).
INGEST_BODY_LIMIT=5mb

# DEV
# BOT_TO_UI_TOKEN=dev
# UI_ORIGIN=*
# PORT=3001
